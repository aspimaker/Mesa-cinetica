<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plataformas -->
    <TargetFrameworks>net10.0-android</TargetFrameworks>
	
    <!-- MAUI -->
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <!-- Básico -->
    <OutputType>Exe</OutputType>
    <RootNamespace>app_mesa_cinetica</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- XAML (rápido) -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <!-- App -->
    <ApplicationTitle>app_mesa_cinetica</ApplicationTitle>
    <ApplicationId>com.aspimaker.mesa_cinetica</ApplicationId>

    <!-- Version -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Plataformas mínimas -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>

	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">31.0</SupportedOSPlatformVersion>
	<AndroidSdkVersion>35</AndroidSdkVersion>
	
    <!-- Rendimiento Android (seguro) -->
    <AndroidEnableMultiDex>false</AndroidEnableMultiDex>
    <Platforms>AnyCPU;ARM64</Platforms>

  </PropertyGroup>

  <!-- ICONO -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#ffffff" ForegroundScale="0.6" />
  </ItemGroup>

  <!-- SPLASH -->
  <ItemGroup>
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#242429" BaseSize="128,128" />
  </ItemGroup>

  <!-- RECURSOS -->
  <ItemGroup>
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- PAQUETES -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

    <!-- Toolkit -->
    <PackageReference Include="CommunityToolkit.Maui" Version="12.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- DB -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.8" />
    <PackageReference Include="Plugin.BLE" Version="3.2.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />

    <!-- UI -->
    <PackageReference Include="SkiaSharp.Extended.UI.Maui" Version="3.0.0" />
    <PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.8" />
  </ItemGroup>

  <!-- XAML -->
  <ItemGroup>
    <MauiXaml Update="*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

</Project>
