<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="app_mesa_cinetica.Views.MusicView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Reproductor actual -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2E}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}"
                    StrokeThickness="0.5" Padding="16">
                <VerticalStackLayout Spacing="0">

                    <Label x:Name="LblTrackTitle" Text="Zen Garden Loop"
                           FontSize="15" FontAttributes="Bold" HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                    <Label x:Name="LblTrackMeta" Text="Track 2 · Ambiental"
                           FontSize="12" HorizontalOptions="Center" Margin="0,4,0,0"
                           TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}" />

                    <Slider x:Name="SliderProgress" Minimum="0" Maximum="1" Value="0.35"
                            Margin="0,14,0,0"
                            ThumbColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                            MinimumTrackColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                            MaximumTrackColor="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}"
                            DragCompleted="OnSeek" />

                    <Grid ColumnDefinitions="*,*" Margin="0,-4,0,0">
                        <Label x:Name="LblTimeCurrent" Text="1:12" FontSize="11"
                               TextColor="{AppThemeBinding Light=#C7C7CC, Dark=#636366}" />
                        <Label x:Name="LblTimeTotal" Text="3:24" FontSize="11"
                               Grid.Column="1" HorizontalOptions="End"
                               TextColor="{AppThemeBinding Light=#C7C7CC, Dark=#636366}" />
                    </Grid>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="16" Margin="0,10,0,0">
                        <ImageButton x:Name="BtnLoop" Source="icon_loop.png"
                                     WidthRequest="40" HeightRequest="40"
                                     BackgroundColor="Transparent" Clicked="OnToggleLoop" />
                        <ImageButton Source="icon_prev.png"
                                     WidthRequest="40" HeightRequest="40"
                                     BackgroundColor="Transparent" Clicked="OnPrevTrack" />
                        <Border BackgroundColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                StrokeShape="RoundRectangle 26" StrokeThickness="0"
                                WidthRequest="52" HeightRequest="52">
                            <ImageButton x:Name="BtnPlay" Source="icon_play.png"
                                         BackgroundColor="Transparent" Clicked="OnTogglePlay" />
                        </Border>
                        <ImageButton Source="icon_stop.png"
                                     WidthRequest="40" HeightRequest="40"
                                     BackgroundColor="Transparent" Clicked="OnStopTrack" />
                        <ImageButton Source="icon_next.png"
                                     WidthRequest="40" HeightRequest="40"
                                     BackgroundColor="Transparent" Clicked="OnNextTrack" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Lista de reproducción -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2E}"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" StrokeThickness="0.5">
                <VerticalStackLayout>
                    <Label Text="LISTA DE REPRODUCCIÓN" FontSize="11" Padding="14,10"
                           CharacterSpacing="1"
                           TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}" />
                    <BoxView HeightRequest="0.5" Color="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" />
                    <Grid ColumnDefinitions="24,*,Auto" Padding="14,10" ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="0" Tapped="OnTrackTapped" />
                        </Grid.GestureRecognizers>
                        <Label Text="1" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#C7C7CC, Dark=#636366}" />
                        <Label Grid.Column="1" Text="Desert Drift" FontSize="13" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                        <Label Grid.Column="2" Text="4:02" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#C7C7CC, Dark=#636366}" />
                    </Grid>
                    <BoxView HeightRequest="0.5" Color="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" />
                    <Grid x:Name="Track1Row" ColumnDefinitions="24,*,Auto" Padding="14,10" ColumnSpacing="10"
                          BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#3A3A3C}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="1" Tapped="OnTrackTapped" />
                        </Grid.GestureRecognizers>
                        <Ellipse WidthRequest="6" HeightRequest="6" Fill="#007AFF" VerticalOptions="Center" HorizontalOptions="Center" />
                        <Label Grid.Column="1" Text="Zen Garden Loop" FontSize="13" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                        <Label Grid.Column="2" Text="3:24" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#C7C7CC, Dark=#636366}" />
                    </Grid>
                    <BoxView HeightRequest="0.5" Color="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" />
                    <Grid ColumnDefinitions="24,*,Auto" Padding="14,10" ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="2" Tapped="OnTrackTapped" />
                        </Grid.GestureRecognizers>
                        <Label Text="3" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#C7C7CC, Dark=#636366}" />
                        <Label Grid.Column="1" Text="Orbital Sands" FontSize="13" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                        <Label Grid.Column="2" Text="5:17" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#C7C7CC, Dark=#636366}" />
                    </Grid>
                    <BoxView HeightRequest="0.5" Color="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" />
                    <Grid ColumnDefinitions="24,*,Auto" Padding="14,10" ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="3" Tapped="OnTrackTapped" />
                        </Grid.GestureRecognizers>
                        <Label Text="4" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#C7C7CC, Dark=#636366}" />
                        <Label Grid.Column="1" Text="Crystal Spiral" FontSize="13" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                        <Label Grid.Column="2" Text="2:48" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#C7C7CC, Dark=#636366}" />
                    </Grid>
                    <BoxView HeightRequest="0.5" Color="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" />
                    <Grid ColumnDefinitions="24,*,Auto" Padding="14,10" ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer CommandParameter="4" Tapped="OnTrackTapped" />
                        </Grid.GestureRecognizers>
                        <Label Text="5" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#C7C7CC, Dark=#636366}" />
                        <Label Grid.Column="1" Text="Wave Form" FontSize="13" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
                        <Label Grid.Column="2" Text="6:11" FontSize="12" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#C7C7CC, Dark=#636366}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>