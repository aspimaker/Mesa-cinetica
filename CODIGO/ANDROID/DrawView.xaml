<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="app_mesa_cinetica.Views.DrawView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16" RowSpacing="10">

        <!-- Barra de herramientas -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8">

            <Border x:Name="BtnPen"
                    BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#3A3A3C}"
                    StrokeShape="RoundRectangle 8"
                    Stroke="{AppThemeBinding Light=#C7C7CC, Dark=#C7C7CC}"
                    StrokeThickness="0.5" Padding="12,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="pen" Tapped="OnToolSelected" />
                </Border.GestureRecognizers>
                <Label Text="Lápiz" FontSize="12"
                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
            </Border>

            <Border x:Name="BtnLine"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 8"
                    Stroke="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}"
                    StrokeThickness="0.5" Padding="12,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="line" Tapped="OnToolSelected" />
                </Border.GestureRecognizers>
                <Label Text="Línea" FontSize="12"
                       TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}" />
            </Border>

            <Border x:Name="BtnCircle"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 8"
                    Stroke="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}"
                    StrokeThickness="0.5" Padding="12,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer CommandParameter="circle" Tapped="OnToolSelected" />
                </Border.GestureRecognizers>
                <Label Text="Círculo" FontSize="12"
                       TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}" />
            </Border>

            <!-- Spacer -->
            <BoxView HorizontalOptions="Fill" Color="Transparent" WidthRequest="1" />

            <!-- Limpiar -->
            <Border BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 8"
                    Stroke="#FF3B30"
                    StrokeThickness="0.5" Padding="12,8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClearCanvas" />
                </Border.GestureRecognizers>
                <Label Text="✕ Limpiar" FontSize="12" TextColor="#FF3B30" />
            </Border>

        </HorizontalStackLayout>

        <!-- Área de dibujo -->
        <GraphicsView
            Grid.Row="1"
            x:Name="DrawingCanvas"
            HorizontalOptions="Fill"
            Margin="12,0"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2E}"
            StartInteraction="OnDrawStart"
            DragInteraction="OnDrawDrag"
            EndInteraction="OnDrawEnd">
        </GraphicsView>

        <!-- Slider de grosor -->
        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2E}"
                StrokeShape="RoundRectangle 8"
                Stroke="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}"
                StrokeThickness="0.5" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="Grosor" FontSize="12" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}" />
                <Slider x:Name="SizeSlider" Grid.Column="1"
                        Minimum="1" Maximum="12" Value="3"
                        VerticalOptions="Center"
                        ValueChanged="OnSizeChanged"
                        ThumbColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                        MinimumTrackColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                        MaximumTrackColor="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}" />
                <Label x:Name="LblSizeVal" Grid.Column="2" Text="3"
                       FontSize="12" MinimumWidthRequest="20" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}" />
                <Ellipse x:Name="SizePreview" Grid.Column="3"
                         WidthRequest="12" HeightRequest="12"
                         Fill="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                         VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Botones inferiores -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="Enviar a mesa ↗" FontSize="13"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                    BorderColor="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}"
                    BorderWidth="0.5" CornerRadius="8" HeightRequest="46"
                    Clicked="OnSendToTable" />
            <Button Grid.Column="1"
                    Text="Guardar" FontSize="13"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                    BorderColor="{AppThemeBinding Light=#E5E5EA, Dark=#3A3A3C}"
                    BorderWidth="0.5" CornerRadius="8" HeightRequest="46"
                    Clicked="OnSaveCanvas" />
        </Grid>

    </Grid>
</ContentView>
